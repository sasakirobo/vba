<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RollForward>LatestMinor</RollForward>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Platforms>x64</Platforms>

		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		
		<!-- DuckDB拡張機能をビルド時に組み込む設定 -->
		<PublishTrimmed>false</PublishTrimmed>
		<DebugType>embedded</DebugType>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="DuckDB.NET.Bindings.Full" Version="1.5.0" />
		<PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.0" />
		<PackageReference Include="ExcelDna.AddIn" Version="1.9.0" />
		<PackageReference Include="ExcelDna.Interop" Version="15.0.1" />
	</ItemGroup>

	<PropertyGroup>
		<ExcelDnaCreate32BitAddIn>false</ExcelDnaCreate32BitAddIn>
		<RunExcelDnaPack>false</RunExcelDnaPack>
		<ExcelAddInName>xlDuckDb</ExcelAddInName>
		<ExcelAddInFileName>xlDuckDb</ExcelAddInFileName>
		<ExcelAddInExplicitExports>true</ExcelAddInExplicitExports>
	</PropertyGroup>

	<!-- DuckDB拡張機能をビルド出力にコピー -->
	<ItemGroup>
		<DuckDbNativeExtensions Include="$(NuGetPackageRoot)duckdb.net.bindings.full\1.5.0\runtimes\win-x64\native\*.so" />
		<DuckDbNativeExtensions Include="$(NuGetPackageRoot)duckdb.net.bindings.full\1.5.0\runtimes\win-x64\native\*.dll" />
	</ItemGroup>

	<Target Name="CopyDuckDbExtensions" AfterTargets="Build">
		<Copy
			SourceFiles="@(DuckDbNativeExtensions)"
			DestinationFolder="$(OutputPath)"
			SkipUnchangedFiles="true"
			ContinueOnError="true"
		/>
	</Target>

</Project>