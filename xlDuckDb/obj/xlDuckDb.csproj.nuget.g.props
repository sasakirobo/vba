<?xml version="1.0" encoding="utf-8" standalone="no"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <RestoreSuccess Condition=" '$(RestoreSuccess)' == '' ">True</RestoreSuccess>
    <RestoreTool Condition=" '$(RestoreTool)' == '' ">NuGet</RestoreTool>
    <ProjectAssetsFile Condition=" '$(ProjectAssetsFile)' == '' ">$(MSBuildThisFileDirectory)project.assets.json</ProjectAssetsFile>
    <NuGetPackageRoot Condition=" '$(NuGetPackageRoot)' == '' ">$(UserProfile)\.nuget\packages\</NuGetPackageRoot>
    <NuGetPackageFolders Condition=" '$(NuGetPackageFolders)' == '' ">C:\Users\tadas\.nuget\packages\;C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages</NuGetPackageFolders>
    <NuGetProjectStyle Condition=" '$(NuGetProjectStyle)' == '' ">PackageReference</NuGetProjectStyle>
    <NuGetToolVersion Condition=" '$(NuGetToolVersion)' == '' ">7.0.0</NuGetToolVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <SourceRoot Include="C:\Users\tadas\.nuget\packages\" />
    <SourceRoot Include="C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages\" />
  </ItemGroup>
  <ItemGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <None Include="$(NuGetPackageRoot)icu.net\2.10.0\contentFiles\any\any\icu.net.dll.config" Condition="Exists('$(NuGetPackageRoot)icu.net\2.10.0\contentFiles\any\any\icu.net.dll.config')">
      <NuGetPackageId>icu.net</NuGetPackageId>
      <NuGetPackageVersion>2.10.0</NuGetPackageVersion>
      <NuGetItemType>None</NuGetItemType>
      <Pack>false</Pack>
      <Private>False</Private>
      <Link>icu.net.dll.config</Link>
    </None>
  </ItemGroup>
  <ImportGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <Import Project="$(NuGetPackageRoot)icu.net\2.10.0\build\icu.net.props" Condition="Exists('$(NuGetPackageRoot)icu.net\2.10.0\build\icu.net.props')" />
    <Import Project="$(NuGetPackageRoot)exceldna.addin\1.9.0\build\ExcelDna.AddIn.props" Condition="Exists('$(NuGetPackageRoot)exceldna.addin\1.9.0\build\ExcelDna.AddIn.props')" />
  </ImportGroup>
  <PropertyGroup Condition=" '$(ExcludeRestorePackageImports)' != 'true' ">
    <PkgNewtonsoft_Json Condition=" '$(PkgNewtonsoft_Json)' == '' ">C:\Users\tadas\.nuget\packages\newtonsoft.json\9.0.1</PkgNewtonsoft_Json>
    <PkgExcelDna_AddIn Condition=" '$(PkgExcelDna_AddIn)' == '' ">C:\Users\tadas\.nuget\packages\exceldna.addin\1.9.0</PkgExcelDna_AddIn>
  </PropertyGroup>
</Project>